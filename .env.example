# ── LLM 后端（OpenAI 兼容接口）─────────────────────────────────────────────
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o
# LLM_MAX_TOKENS=4096

# ── 记忆数据库（默认 ~/.ai-agent/memory.db）───────────────────────────────
AGENT_MEMORY_DB=~/.ai-agent/memory.db

# ── Web 搜索插件 ─────────────────────────────────────────────────────────────
# 默认使用 DuckDuckGo（无需 key）；改为 serper 或 searxng 需填写以下配置
WEB_SEARCH_ENGINE=duckduckgo     # 可选: duckduckgo | serper | searxng
WEB_SEARCH_API_KEY=              # Serper 需要；DuckDuckGo 和 SearXNG 无需
WEB_SEARCH_BASE_URL=             # SearXNG 自托管地址，如 http://localhost:8080
                                 # Serper 可不填（默认 https://google.serper.dev）
